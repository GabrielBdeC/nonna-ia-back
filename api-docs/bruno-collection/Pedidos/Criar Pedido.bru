meta {
  name: Criar Pedido
  type: http
  seq: 1
}

post {
  url: http://localhost:8080/pedidos
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "idCliente": "uuid-do-cliente",
    "precoTotal": 150.00,
    "tipoEntrega": "Entrega",
    "endereco": "Rua X",
    "formaPagamento": "PIX",
    "telefone": "11999999999"
  }
}
